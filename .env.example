# Copy to .env. Every key below is required — the api refuses to start with one
# missing, and there are no defaults. An empty value is allowed and is read as
# an empty value, not as "unset".
#
# RUST_LOG and LOG_FORMAT are not here: telemetry initialises before .env is
# read, so they have to come from the real environment.

# Shared with luxctl. Signed routes verify an HMAC-SHA256 over the body with it.
LUXCTL_SECRET=

# Loopback port the api binds. Caddy proxies to it.
API_PORT=9000

# Postgres. `make db` starts one from compose.yaml on port 5433 — 5433 and not
# 5432 so it can run alongside the laravel stack's:
#
#   DATABASE_URL=postgres://lighthouse:lighthouse@127.0.0.1:5433/lighthouse
#
# Point it at the laravel database instead to work against real content; that
# one is already built, so it wants `baseline` rather than `run`.
#
# Migrations are not run at boot. A deploy that doubles as a schema change turns
# a failed migration into a container that will not start, so they are applied
# deliberately with `lighthouse-migrate`:
#
#   run       a fresh database — executes migration 0 and builds the schema
#   baseline  a database laravel already built — records migration 0 as applied
#             without executing it, so forward migrations can run there
#   status    which of the two you are looking at
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/projectlighthouse

# The site's own origin, no trailing path. Two things derive from it: the OAuth
# callback URLs registered with each provider, and whether cookies are marked
# Secure — https here means Secure cookies, and a Secure cookie is dropped
# outright over plain http, which is why local development uses http://.
APP_URL=http://localhost:8080

# Where ohara — the content repo — is checked out. The prose is private and
# lives outside this repo entirely; only the folder structure is known here.
CONTENT_PATH=../ohara

# Social sign-in. An empty client id skips that provider entirely: its button
# 404s rather than dead-ending on the provider's error page, so a deployment can
# run with only one of the two configured.
#
# The callback to register with each provider is APP_URL plus the path below,
# byte for byte — the provider compares it again at the token exchange. It is
# the path the laravel app serves, kept on purpose so existing registrations
# carry over and the cutover does not wait on two OAuth consoles:
#
#   GitHub  <APP_URL>/github/callback
#   Google  <APP_URL>/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Unfinished lessons. Exactly `true` loads drafts so they can be read while
# being written; anything else, and absence above all, means they do not exist
# — no row, no response. Never set this in production.
SHOW_DRAFTS=true

# Payments. STRIPE_SECRET_KEY is the api key; STRIPE_WEBHOOK_SECRET is the
# `whsec_…` shown when the webhook endpoint is created, which is per endpoint —
# staging and production do not share one, and using the wrong one refuses
# every delivery with no clue as to why.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# What is on sale, and the provider's handle for each plan. Gitignored and
# injected at deploy time: which plans exist is a deployment's business rather
# than this repository's. A clone runs against the sample, which parses and
# boots but cannot charge anybody.
BILLING_PLANS=crates/billing/billing.sample.yaml
